{
  "name": "durable-harness-benchmarks",
  "main": "worker.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": { "bindings": [{ "name": "BENCHMARKS", "class_name": "BenchmarkRun" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BenchmarkRun"] }],
  "worker_loaders": [{ "binding": "LOADER" }],
  "ai": { "binding": "AI" },
  "vars": { "MODEL_ID": "@cf/zai-org/glm-5.3-flash" },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "limits": { "cpu_ms": 30000 },
  "observability": { "enabled": false },
}
