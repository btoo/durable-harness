{
  "name": "durable-harness-mcp-fixture",
  "main": "worker.ts",
  "compatibility_date": "2026-08-22",
  "durable_objects": { "bindings": [{ "name": "CATALOG", "class_name": "SyntheticCatalog" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SyntheticCatalog"] }],
  "vars": {
    "CALLBACK_ORIGINS": "https://durable-harness-demo.btjk138.workers.dev,http://localhost:5173",
  },
  "limits": { "cpu_ms": 50 },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "observability": { "enabled": false },
}
