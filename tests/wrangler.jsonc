{
  "name": "durable-harness-tests",
  "main": "runtime/worker.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "WORKSPACES", "class_name": "WorkspaceTestHost" },
      { "name": "APPLICATIONS", "class_name": "DemoApplication" },
      { "name": "MODEL_AGENTS", "class_name": "TestHarnessThink" },
      { "name": "MCP_TESTS", "class_name": "McpTestHost" },
      { "name": "CATALOG", "class_name": "SyntheticCatalog" },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "WorkspaceTestHost",
        "DemoApplication",
        "TestHarnessThink",
        "McpTestHost",
        "SyntheticCatalog",
      ],
    },
  ],
  "worker_loaders": [{ "binding": "LOADER" }],
  "r2_buckets": [{ "binding": "ARTIFACTS", "bucket_name": "durable-harness-test-artifacts" }],
  "vars": {
    "DEMO_MODE": "synthetic",
    "SESSION_SECRET": "test-only-session-secret-at-least-32-characters",
    "CREDENTIAL_KEY": "YWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWE=",
    "MODEL_ID": "synthetic",
    "ADMIN_TOKEN": "test-only-model-admission",
    "MCP_ALLOWED_ORIGINS": "https://fixture.example.test",
    "CALLBACK_ORIGINS": "https://fixture.example.test",
    "TEST_CONTROL_TOKEN": "test-only-fixture-control",
  },
}
